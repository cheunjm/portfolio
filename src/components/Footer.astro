---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-inner">
		<p class="fine-print">&copy; {year} Jaemin Cheun. Built with Astro.</p>
		<ul class="footer-links">
			<li>
				<a href="https://github.com/cheunjm" target="_blank" rel="noopener noreferrer">
					GitHub
				</a>
			</li>
			<li>
				<a
					href="https://www.linkedin.com/in/jaemincheun"
					target="_blank"
					rel="noopener noreferrer"
				>
					LinkedIn
				</a>
			</li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		margin-top: auto;
	}

	.footer-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 12px;
		padding-top: 32px;
		padding-bottom: 32px;
	}

	.fine-print {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-dim);
	}

	.footer-links {
		display: flex;
		gap: 24px;
	}

	.footer-links a {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--text-dim);
	}

	.footer-links a:hover {
		color: var(--accent);
	}

	@media (max-width: 640px) {
		.footer-inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
