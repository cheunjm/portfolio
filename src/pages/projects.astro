---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';

const allProjects = await getCollection(
	'projects',
	({ data }) => !data.hidden,
);

const projects = allProjects.sort((a, b) => {
	if (a.data.featured !== b.data.featured) {
		return a.data.featured ? -1 : 1;
	}
	return b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf();
});
---

<BaseLayout title="Projects — Jaemin Cheun">
	<Header activePage="projects" />

	<main>
		<section class="intro container">
			<span class="section-label">Projects</span>
			<p class="intro-text">A selection of open-source repositories.</p>
		</section>

		<section class="grid-section container">
			{
				projects.length > 0 ? (
					<div class="grid">
						{projects.map((project) => (
							<ProjectCard project={project} />
						))}
					</div>
				) : (
					<p class="empty">
						No projects yet — run <code>npm run sync-projects</code> to
						pull repos from GitHub.
					</p>
				)
			}
		</section>
	</main>

	<Footer />
</BaseLayout>

<style>
	.intro {
		padding-top: var(--section-pad-y);
		padding-bottom: 32px;
	}

	.intro-text {
		margin-top: 16px;
		color: var(--text-dim);
	}

	.grid-section {
		padding-bottom: var(--section-pad-y);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 24px;
	}

	.empty {
		font-family: var(--font-mono);
		font-size: 15px;
		color: var(--text-dim);
	}

	.empty code {
		color: var(--accent);
	}

	@media (max-width: 640px) {
		.intro {
			padding-top: 48px;
		}

		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
